# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.installed.cfg
*.egg

# Virtual envs
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# Data — never commit raw scans / generated datasets
# Anchored to the repo root so they do NOT also match the src/deepussim/data package.
/data/
/datasets/
*.nii
*.nii.gz
*.dcm
*.npz
!tests/**/*.npz

# Stray raw inputs accidentally dropped at the repo root (real copies belong under /data/).
/*.bag
/*.stl

# Outputs
outputs/
runs/
*.png
!docs/**/*.png
# Visualization figures are tracked intentionally (PNG/PDF/GIF under figures/).
!figures/**/*.png

# OS / editor
.DS_Store
*.swp
.vscode/
.idea/
